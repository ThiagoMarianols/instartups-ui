# Copie para .env e preencha (ou cadastre as mesmas variáveis na stack do Portainer).

# Imagem (tag publicada no GHCR: latest, develop, homolog, main, x.y.z, sha-xxxxxxx)
IMAGE_TAG=

# Domínio raiz do front (sem www; o www redireciona para ele). Ex.: instartups.tech
FRONT_DOMAIN=

# URLs das APIs (lidas só no servidor do Next — BFF), sem barra no final. Ex.: https://api.instartups.tech
AUTH_API_URL=
COMMAND_API_URL=
QUERY_API_URL=

# Cloudflare R2 (upload de imagens e mídias). Sem estas variáveis o upload fica desabilitado.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# URL pública do bucket (domínio próprio ou https://pub-<hash>.r2.dev), sem barra no final.
# NÃO use o endpoint S3 (<conta>.r2.cloudflarestorage.com): ele só aceita requisições assinadas e as imagens não carregam.
R2_PUBLIC_BASE_URL=
