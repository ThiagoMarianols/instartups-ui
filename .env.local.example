# URLs das APIs (lidas só no servidor do Next — BFF)
AUTH_API_URL=http://localhost:8080
COMMAND_API_URL=http://localhost:8081
QUERY_API_URL=http://localhost:8082

# Cloudflare R2 (upload de imagens e mídias). Sem estas variáveis o upload fica desabilitado.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# URL pública do bucket (domínio próprio ou https://pub-<hash>.r2.dev), sem barra no final.
# NÃO use o endpoint S3 (<conta>.r2.cloudflarestorage.com): ele só aceita requisições assinadas e as imagens não carregam.
R2_PUBLIC_BASE_URL=
